diff -ruN -x __pycache__ -x '*.pyc' a/freetoken/engine/layer_graph.py b/freetoken/engine/layer_graph.py
--- a/freetoken/engine/layer_graph.py	1970-01-01 01:00:00.000000000 +0100
+++ b/freetoken/engine/layer_graph.py	2026-09-09 09:16:51.551256511 +0200
@@ -0,0 +1,294 @@
+"""Partial CUDA-graph capture for Qwen3.8-Flash-Next's offload-MoE decode path.
+
+``GraphRunner`` (``graph.py``) captures ``model.forward()`` whole, which only works when
+every op the forward touches is capture-safe. ``NvmeOffloadMoeCache.ensure_experts``
+(``nvme_offload_cache.py``) is not: it calls ``.item()`` and ``.cpu().tolist()`` to decide
+which experts need an NVMe ``preadv`` before the GPU-side slot cache can be updated, and
+both calls are illegal inside ``torch.cuda.graph()`` capture.
+
+``MoeLayerGraphRunner`` captures everything BETWEEN the MoE calls instead: per decoder
+layer, the hyper-connection mix/combine and the GDN/QSA attention op never touch expert
+paging (static resident buffers, fixed shapes, no host sync), so each of those spans
+becomes its own tiny CUDA graph, with the MoE dispatch itself left eager in between.
+
+Region layout (see ``models/qwen4_exp/model.py:76-86`` for the reference eager forward):
+
+    Graph[0]    = attn_hc.mix(0) + attn/GDN(0) + attn_hc.combine(0) + mlp_hc.mix(0)
+    <eager>     = MoE(0)
+    Graph[L]    = mlp_hc.combine(L-1) + attn_hc.mix(L) + attn/GDN(L)
+                  + attn_hc.combine(L) + mlp_hc.mix(L)              for L = 1..num_layers-1
+    <eager>     = MoE(L)
+    Graph[tail] = mlp_hc.combine(num_layers-1) + hyper_connection_mixer.mix + lm_head
+
+Merging layer L-1's ``mlp_hc.combine`` into layer L's graph (instead of giving it a
+standalone one-kernel graph) avoids replaying a whole CUDA graph for a single kernel,
+which is the one case in this model where the fixed per-replay overhead could rival the
+eager dispatch cost it's trying to avoid.
+
+Cross-graph data (values a later graph's capture reads that an earlier graph's capture,
+or the eager MoE call in between, produced) is staged through persistent buffers exactly
+like ``GraphCaptureBuffer`` stages ``input_ids``/``positions`` for the whole-model runner:
+``x_buf`` (post-attn-combine hidden), ``s_buf`` (the mlp-mix inject logits), ``moe_in_buf``
+(the MoE call's input), ``y_buf`` (the MoE call's output). ``shared_gate_mul_add``
+allocates its output fresh every call (``moe_shared_gate.py``), so ``y_buf`` is not
+optional -- without it, the next graph would read whatever the caching allocator happened
+to place at that now-stale address.
+
+Each layer graph gets its OWN CUDA graph memory pool (no ``pool=`` sharing across the
+per-layer graphs, unlike ``GraphRunner``'s same-shape multi-bs graphs, which share one
+pool because their tensors are never read across pool boundaries). QSA's
+``_plan_index_writes`` (``attention/qsa_sparse.py``) allocates ``cmp_rows``/``ring_rows``
+fresh on the first QSA layer of a forward and every later QSA layer reads that same
+Python-held tensor reference; if two of my layer graphs shared a pool, the allocator could
+place a later graph's own scratch tensor at that exact address, silently corrupting the
+read. Giving each layer its own pool keeps that address reserved for the life of the
+runner (we hold every ``CUDAGraph`` object in ``self.graphs``), at the cost of a little
+extra VRAM -- see the runner's log line for the measured delta.
+
+The disk PLE backend's WAIT/signal protocol (``models/qwen4_exp/ple_disk.py``) assumes one
+graph replay followed immediately by Python-only work until the deferred host fill runs;
+threading a blocking host sync (MoE's ``ensure_experts``) between a captured PLE lookup and
+that deferred fill would deadlock the decode step. So layer 0's ``ple.forward`` (and the
+embedding lookup that feeds it) stay eager here, every replay, never captured -- see
+``EngineWithLayerGraph.forward_batch`` in ``engine.py`` for the matching
+``forward_host_ctx(batch, use_graph=False)`` override that keeps PLE's own graph/non-graph
+branch consistent with that choice.
+
+Scope: bs=1 decode only (this model's deployed config runs `--max-running-req 1`, which
+collapses GDN's recurrent state to one slot; a batched version would need per-bs graph
+sets exactly like ``GraphRunner``'s ``graph_bs_list``, which is future work, not attempted
+here).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, List
+
+import torch
+from freetoken.core import Batch, Req, get_global_ctx
+from freetoken.utils import init_logger, mem_GB
+
+from .graph import get_free_memory
+
+if TYPE_CHECKING:
+    from freetoken.attention import BaseAttnBackend
+    from freetoken.models.qwen4_exp.model import Qwen4ExpForCausalLM
+    from freetoken.moe.offload_cache import OffloadMoeCache
+
+logger = init_logger(__name__)
+
+
+class MoeLayerGraphRunner:
+    """Drop-in alternative to ``GraphRunner`` for bs=1 offload-MoE decode.
+
+    Implements the same call surface (``can_use_cuda_graph``, ``replay``, ``pad_batch``,
+    ``destroy_cuda_graphs``) so ``engine.py`` can hold either behind ``self.graph_runner``.
+    """
+
+    def __init__(
+        self,
+        stream: torch.cuda.Stream,
+        device: torch.device,
+        model: "Qwen4ExpForCausalLM",
+        attn_backend: "BaseAttnBackend",
+        max_seq_len: int,
+        vocab_size: int,
+        dummy_req: Req,
+        moe_offload_cache: "OffloadMoeCache | None",
+    ) -> None:
+        self.attn_backend = attn_backend
+        self.dummy_req = dummy_req
+        self.moe_offload_cache = moe_offload_cache
+        self.stream = stream
+        self.device = device
+        self.model = model
+        self.qwen_model = model.model  # Qwen4ExpModel
+        self.layers = list(self.qwen_model.layers.op_list)
+        self.num_layers = len(self.layers)
+        self.hc_count = self.qwen_model.hc_count
+        self.hidden_size = model._config.hidden_size
+        self.vocab_size = vocab_size
+        self.graphs: List[torch.cuda.CUDAGraph] = []
+        self.max_graph_bs = 1  # can_use_cuda_graph gate; bs=1 only
+        self.graph_bs_list = [1]
+        self._capture(max_seq_len)
+
+    # ------------------------------------------------------------------
+    # Capture
+    # ------------------------------------------------------------------
+
+    def _make_batch(self) -> Batch:
+        batch = Batch(reqs=[self.dummy_req], phase="decode")
+        batch.padded_reqs = batch.reqs
+        return batch
+
+    def _bind_step_buffers(self, batch: Batch) -> None:
+        """Point this step's ``batch`` at the persistent input buffers (mirrors
+        ``GraphCaptureBuffer.set_batch``)."""
+        from freetoken.attention.linear import FLAMetadata
+
+        batch.input_ids = self.input_ids
+        batch.out_loc = self.out_loc
+        batch.positions = self.positions
+        batch.linear_table_idx = self.table_idx
+        batch.fla_metadata = FLAMetadata(
+            cu_seqlens=self.fla_cu_seqlens, cache_indices=self.table_idx
+        )
+
+    def _layer_pre_moe(self, layer, hidden: torch.Tensor, batch: Batch):
+        block_input, inject_a = layer.attn_hyper_connection.mix(hidden)
+        if layer._is_linear:
+            block_output = layer.linear_attn.forward(block_input)
+        else:
+            block_output = layer.self_attn.forward(block_input, batch)
+        x_mid = layer.attn_hyper_connection.combine(hidden, block_output, inject_a)
+        moe_input, inject_m = layer.mlp_hyper_connection.mix(x_mid)
+        return x_mid, moe_input, inject_m
+
+    def _layer_post_moe(self, layer, x_mid: torch.Tensor, moe_out: torch.Tensor, inject_m: torch.Tensor):
+        return layer.mlp_hyper_connection.combine(x_mid, moe_out, inject_m)
+
+    def _refresh_embed_buf(self, batch: Batch) -> None:
+        """Embedding lookup + layer 0's PLE (if any): kept eager, never captured -- see
+        the module docstring for why (disk-PLE WAIT/signal deadlock risk). Writes into
+        ``embed_buf``, which graph[0]'s capture only ever READS -- the lookup itself
+        never runs inside a ``torch.cuda.graph()`` context."""
+        hidden = self.qwen_model.embed_tokens.forward(self.input_ids).repeat(1, self.hc_count)
+        layer0 = self.layers[0]
+        if layer0.ple is not None:
+            hidden = hidden + layer0.ple.forward(hidden, batch)
+        self.embed_buf.copy_(hidden)
+
+    def _reset_moe_offload_cache(self) -> None:
+        if self.moe_offload_cache is not None:
+            self.moe_offload_cache.reset()
+
+    def _capture(self, max_seq_len: int) -> None:
+        self.attn_backend.init_capture_graph(max_seq_len=max_seq_len, bs_list=[1])
+
+        torch.cuda.synchronize(self.device)
+        torch.cuda.empty_cache()
+        torch.cuda.reset_peak_memory_stats(self.device)
+        free_before = get_free_memory(self.device)
+        logger.info_rank0(f"Free GPU memory before layer-graph capture: {mem_GB(free_before)}")
+
+        dev = self.device
+        model_dtype = self.qwen_model.embed_tokens.weight.dtype
+        self.input_ids = torch.zeros(1, dtype=torch.int32, device=dev)
+        self.out_loc = torch.zeros(1, dtype=torch.int32, device=dev)
+        self.positions = torch.zeros(1, dtype=torch.int32, device=dev)
+        self.table_idx = torch.zeros(1, dtype=torch.int32, device=dev)
+        self.fla_cu_seqlens = torch.arange(2, dtype=torch.int32, device=dev)
+        self.embed_buf = torch.zeros(1, self.hc_count * self.hidden_size, dtype=model_dtype, device=dev)
+        self.x_buf = torch.zeros(1, self.hc_count * self.hidden_size, dtype=model_dtype, device=dev)
+        self.s_buf = torch.zeros(1, self.hc_count, dtype=model_dtype, device=dev)
+        self.moe_in_buf = torch.zeros(1, self.hidden_size, dtype=model_dtype, device=dev)
+        self.y_buf = torch.zeros(1, self.hidden_size, dtype=model_dtype, device=dev)
+        self.logits_buf = torch.empty(1, self.vocab_size, dtype=torch.float32, device=dev)
+
+        batch = self._make_batch()
+        self._bind_step_buffers(batch)
+        dummy_slot = (
+            self.dummy_req.linear_slot_idx
+            if self.dummy_req.linear_slot_idx is not None
+            else self.dummy_req.table_idx
+        )
+        self.table_idx.fill_(dummy_slot)
+        self.attn_backend.prepare_for_capture(batch)
+        self._reset_moe_offload_cache()
+
+        with get_global_ctx().forward_batch(batch):
+            for layer_idx, layer in enumerate(self.layers):
+                self._capture_layer_graph(layer_idx, layer, batch)
+                # Eager MoE dispatch: warm it (NVMe/host resolution), then reset the
+                # offload cache so the NEXT (real) run replays cold-cache expert copies,
+                # matching GraphRunner's own warm-then-reset convention.
+                y = layer.mlp.forward(self.moe_in_buf)
+                self.y_buf.copy_(y)
+                self._reset_moe_offload_cache()
+
+            self._capture_tail_graph()
+
+        free_after = get_free_memory(self.device)
+        logger.info_rank0(
+            f"Layer-graph capture done: {len(self.graphs)} graphs, "
+            f"free GPU memory before={mem_GB(free_before)} after={mem_GB(free_after)} "
+            f"(pool overhead ~{mem_GB(free_before - free_after)})"
+        )
+
+    def _capture_layer_graph(self, layer_idx: int, layer, batch: Batch) -> None:
+        graph = torch.cuda.CUDAGraph()
+
+        def region_input() -> torch.Tensor:
+            if layer_idx == 0:
+                return self.embed_buf
+            prev = self.layers[layer_idx - 1]
+            return self._layer_post_moe(prev, self.x_buf, self.y_buf, self.s_buf)
+
+        if layer_idx == 0:
+            self._refresh_embed_buf(batch)
+        # Warm once eagerly first (autotune caches, lazy metadata) before recording.
+        x_mid, moe_input, inject_m = self._layer_pre_moe(layer, region_input(), batch)
+        self.x_buf.copy_(x_mid)
+        self.moe_in_buf.copy_(moe_input)
+        self.s_buf.copy_(inject_m)
+
+        with torch.cuda.graph(graph, stream=self.stream):
+            x_mid, moe_input, inject_m = self._layer_pre_moe(layer, region_input(), batch)
+            self.x_buf.copy_(x_mid)
+            self.moe_in_buf.copy_(moe_input)
+            self.s_buf.copy_(inject_m)
+        self.graphs.append(graph)
+
+    def _capture_tail_graph(self) -> None:
+        graph = torch.cuda.CUDAGraph()
+        last = self.layers[-1]
+        hidden = self._layer_post_moe(last, self.x_buf, self.y_buf, self.s_buf)
+        mixed = self.qwen_model.hyper_connection_mixer.mix(hidden)[0]
+        logits = self.model.lm_head.forward(mixed)
+        self.logits_buf.copy_(logits)
+
+        with torch.cuda.graph(graph, stream=self.stream):
+            hidden = self._layer_post_moe(last, self.x_buf, self.y_buf, self.s_buf)
+            mixed = self.qwen_model.hyper_connection_mixer.mix(hidden)[0]
+            logits = self.model.lm_head.forward(mixed)
+            self.logits_buf.copy_(logits)
+        self.graphs.append(graph)
+
+    # ------------------------------------------------------------------
+    # Replay
+    # ------------------------------------------------------------------
+
+    def can_use_cuda_graph(self, batch: Batch) -> bool:
+        return batch.is_decode and batch.size == 1
+
+    def pad_batch(self, batch: Batch) -> None:
+        batch.padded_reqs = batch.reqs
+
+    def replay(self, batch: Batch) -> torch.Tensor:
+        assert self.can_use_cuda_graph(batch)
+        self.input_ids.copy_(batch.input_ids)
+        if batch.out_loc is not None:
+            self.out_loc.copy_(batch.out_loc)
+        self.positions.copy_(batch.positions)
+        if batch.linear_table_idx is not None:
+            self.table_idx.copy_(batch.linear_table_idx)
+        self._bind_step_buffers(batch)
+        self.attn_backend.prepare_for_replay(batch)
+        self._refresh_embed_buf(batch)
+
+        for layer_idx, layer in enumerate(self.layers):
+            self.graphs[layer_idx].replay()
+            y = layer.mlp.forward(self.moe_in_buf)
+            self.y_buf.copy_(y)
+        self.graphs[self.num_layers].replay()
+        return self.logits_buf[: batch.size]
+
+    def destroy_cuda_graphs(self) -> None:
+        import gc
+
+        self.graphs = []
+        for name in ("embed_buf", "x_buf", "s_buf", "moe_in_buf", "y_buf", "logits_buf",
+                     "input_ids", "out_loc", "positions", "table_idx", "fla_cu_seqlens"):
+            setattr(self, name, None)
+        gc.collect()
